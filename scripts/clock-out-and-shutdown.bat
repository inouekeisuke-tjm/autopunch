@echo off
chcp 65001 >nul
title 自動退勤 ＆ シャットダウン

cd /d "%~dp0.."

echo ---------------------------------------------------
echo  自動退勤＆シャットダウン処理を開始します...
echo ---------------------------------------------------

call npx tsx scripts/clock-out-and-shutdown.mts

if %ERRORLEVEL% NEQ 0 (
    echo.
    echo ===================================================
    echo  エラーが発生しました。
    echo  安全のためPCのシャットダウンは行いませんでした。
    echo ===================================================
    echo.
    pause
)

